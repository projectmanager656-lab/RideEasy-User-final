NODE_ENV=development
PORT=5001

# New drivers: free launch trial in days (0 = off; use subscription plan selected at signup for expiry instead).
# RIDEEASY_LAUNCH_TRIAL_DAYS=14
RIDEEASY_LAUNCH_TRIAL_DAYS=0

# MongoDB: use either MONGO_URI or MONGODB_URI (Atlas / local). Dev falls back to 127.0.0.1 if both unset.
# Atlas example:
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/rideeasy?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/rideeasy
# MONGODB_URI=

# JWT: production requires 32+ random chars (openssl rand -base64 48)
JWT_SECRET=change-me-min-32-chars-random
# Optional token lifetime (default 24h)
# JWT_EXPIRES_IN=24h

# Mongo connection tuning (optional)
# MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
# MONGO_MAX_POOL_SIZE=10
# MONGO_CONNECT_RETRIES=5
# MONGO_CONNECT_RETRY_MS=2000

# Atlas collections used by this app (same DB):
# users | drivers (captains) | rides | admins | pricings | services | notifications | payments | subscriptions | driverlocations | blacklisttokens

# Socket.IO — optional JWT on handshake (auth.token or query.token); backward compatible when omitted.
# SOCKET_REJECT_INVALID_JWT=true   # reject connection if token invalid (default: allow anonymous like today)
# RIDEEASY_STANDARD_SOCKET_EVENTS=true   # also emit ride:completed etc. alongside legacy events

# Persist sampled GPS to Mongo TTL collection (optional; extra writes)
# DRIVER_LOCATION_PERSIST=true
# DRIVER_LOCATION_TTL_SEC=86400

# Logging: error | warn | info | debug
# LOG_LEVEL=info

# Production: comma-separated frontend HTTPS origins (required unless CORS_ALLOW_ALL=true)
# CORS_ORIGINS=https://app.example.com,https://www.example.com,https://localhost
# Single SPA URL (merged into CORS allow list; can use instead of or with CORS_ORIGINS)
# FRONTEND_URL=https://app.example.com
# FRONTEND_ORIGIN=  (alias)
# Capacitor APK (bundled dist): backend allows https://localhost WebView origin automatically.
# If capacitor.config.json server.url points at a hosted site (e.g. Vercel), either list it explicitly:
# CORS_ORIGINS=https://cab-frontend-delta.vercel.app
# …or set (allows any *.vercel.app origin — use only if you trust Vercel deploys):
# CORS_ALLOW_VERCEL_APP=true
# CLIENT_ORIGINS=   (alias for CORS_ORIGINS)

# CORS_DEBUG=true
# LOGIN_DEBUG=true
# REQUEST_LOG_DEBUG=true

# Optional bootstrap admin (change in production)
# DEFAULT_ADMIN_EMAIL=admin@example.com
# DEFAULT_ADMIN_PASSWORD=use-strong-secret
# ADMIN_LOGIN_DEBUG=true

RATE_LIMIT_MAX=400
COMMISSION_PERCENT=15
# PENDING_RIDE_MAX_AGE_MIN=45

# Scheduled rides -------------------------------------------------------------
# How long before the requested pickup the backend starts searching for a driver.
# A pickup inside this window starts searching immediately (treated as Book Now),
# so the Schedule picker refuses times closer than this lead.
# Default 1 minute: lets a ride scheduled ~10 minutes ahead stay `scheduled`.
# Raise it in production if the driver search needs a longer run-up — the client
# picker reads this same value via GET /config/scheduling and adapts automatically.
# SCHEDULED_RIDE_DISPATCH_LEAD_MINUTES=1
# How often the in-process dispatcher scans for due scheduled rides (ms, min 1000).
# SCHEDULED_RIDE_SCHEDULER_INTERVAL_MS=30000

# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# FORCE_HTTPS=true
# CORS_ALLOW_ALL=true

# OSRM base URL (no path suffix). Default: https://router.project-osrm.org
# OSRM_URL=https://router.project-osrm.org

# Photon geocoder (full API path, no trailing slash). Default: https://photon.komoot.io/api
# PHOTON_API_URL=https://photon.komoot.io/api
# PHOTON_BBOX=72,16,76,20
# PHOTON_BIAS_LAT=18.5204
# PHOTON_BIAS_LON=73.8567

# GOOGLE_MAPS_API_KEY=
# Google Identity Services web client ID; must match user-app VITE_GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_ID=

# --- Pre-ride 25% advance (Razorpay) ---
# Server-side only. The passenger app never sees the secret and there is no UPI VPA
# to configure: Razorpay is the merchant, and its UPI app-intent flow opens the
# installed UPI app (Google Pay / PhonePe / Paytm / BHIM ...) with the amount prefilled.
# Also required on the Razorpay account: UPI + UPI Intent enabled for the account, and
# in live mode the serving domain allow-listed. Test keys work without a live account.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Webhook URL to add in the Razorpay dashboard: POST https://<your-api-host>/webhooks/razorpay
# Events: payment.captured, order.paid (ride_fare advance reconciliation)

# Live Chat AI assistant (POST /chat). Server-side only — never put these in the mobile app.
# Any OpenAI-compatible endpoint works: OpenAI, Gemini (openai-compatible), Groq, OpenRouter, Ollama, …
# openai | gemini  → pick the provider default base URL + model
AI_PROVIDER=openai
# Required. Chat returns a friendly "not available" message while this is unset.
# AI_API_KEY=
# Overrides AI_PROVIDER defaults. openai → https://api.openai.com/v1
# gemini → https://generativelanguage.googleapis.com/v1beta/openai
# AI_BASE_URL=
# Defaults: gpt-4o-mini (openai), gemini-2.0-flash (gemini)
# AI_MODEL=
# Per-passenger provider timeout and per-minute message limit
# AI_TIMEOUT_MS=20000
# CHAT_RATE_MAX=20
