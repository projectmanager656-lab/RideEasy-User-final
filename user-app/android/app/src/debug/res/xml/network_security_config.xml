<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY override (build/src/debug takes precedence over main for debug builds).

  A physical Android device cannot reach the Mac through "localhost" — it must use the
  Mac's LAN IP (VITE_BASE_URL=http://<MAC-LAN-IP>:5001), which is plain HTTP. The main
  config keeps cleartext disabled for release/HTTPS builds; here we allow it so local
  device testing works regardless of which LAN IP the Mac currently has.

  `cap run android` / `assembleDebug` use this file. Release builds do not.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
