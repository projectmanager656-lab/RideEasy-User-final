# Used automatically when you run: npm run build
#
# MUST match the backend the DRIVER app talks to, otherwise a ride created by the
# passenger is dispatched on a different server and the driver never sees it.
# driver-app/.env.production uses https://cab-backend-o3sg.onrender.com — keep these
# two values identical.
VITE_BASE_URL=https://cab-backend-o3sg.onrender.com
VITE_SOCKET_URL=https://cab-backend-o3sg.onrender.com

# TEMPORARY device diagnostics: logs API method/URL/status and socket connect/
# disconnect/join to logcat (adb logcat | grep Capacitor/Console). Unset once the
# phone is confirmed talking to the backend — it is noisy for normal use.
VITE_DEBUG_LOGS=true

VITE_UPI_HANDLE=merchant@upi
VITE_UPI_PAYEE_NAME=RideEasy
