# Used automatically when you run: npm run build
#
# This tester build must talk to the backend that serves the correct account state
# for the phone under test. The previous value (https://cab-backend-o3sg.onrender.com)
# was a stale deployment running older code / a different account DB, which returned
# 403 "Account suspended" for a user whose blocked field is false. Point the physical
# device at the LAN backend instead. On a real release, restore the deployed HTTPS URL
# (and make sure that deployment runs the current backend code + database).
VITE_BASE_URL=http://192.168.1.15:5001
VITE_SOCKET_URL=http://192.168.1.15:5001

# TEMPORARY device diagnostics: logs API method/URL/status and socket connect/
# disconnect/join to logcat (adb logcat | grep Capacitor/Console). Unset once the
# phone is confirmed talking to the backend — it is noisy for normal use.
VITE_DEBUG_LOGS=true

VITE_UPI_HANDLE=merchant@upi
VITE_UPI_PAYEE_NAME=RideEasy
