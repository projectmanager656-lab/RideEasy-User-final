# This build is the passenger app. Role is also set in vite.config.js (VITE_APP_ROLE=user).
# VITE_APP_ROLE=user

# Vite env files:
#   .env              → local dev (npm run dev) — copy from this file; usually gitignored
#   .env.production   → production build (npm run build) — public API URL only
# Render dashboard: set VITE_* for cloud builds too.

# API origin — no trailing slash; required for production web builds (set in CI/host env).
# Alias: VITE_API_BASE_URL
VITE_BASE_URL=http://localhost:5001

# Production example (use .env.production or host env at build time):
# VITE_BASE_URL=https://your-backend-xxxx.onrender.com

# --- Capacitor Android / iOS ---
# Before `npm run build && npx cap sync`, set VITE_BASE_URL to a URL the *device* can reach:
#   - Deployed API: https://your-api.onrender.com (recommended; use HTTPS)
#   - Dev on LAN: http://192.168.x.x:5001 (AndroidManifest allows cleartext; emulator → host: http://10.0.2.2:5001)
# Do NOT use http://localhost:5001 in an APK — that is the phone itself, not your PC.
# Optional: load a deployed web app in the WebView — in capacitor.config.json set server.url to your frontend HTTPS URL, then add that same URL to backend CORS_ORIGINS in production.

# Optional: axios timeout in ms (default 30000)
# VITE_API_TIMEOUT_MS=30000

# API on serverless cannot hold Socket.IO — optional:
# VITE_DISABLE_SOCKET=true

# Maps / tiles / routing (optional; defaults match public OSM / OSRM / Google dir links)
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_OSRM_URL=https://router.project-osrm.org
# VITE_EXTERNAL_MAPS_DIR_URL=https://www.google.com/maps/dir
# VITE_QR_CODE_API_BASE=https://api.qrserver.com/v1/create-qr-code
# VITE_APP_LOGO_URL=
# VITE_PLACEHOLDER_AVATAR_URL=

# Vite dev server only — extra allowedHosts (comma-separated), e.g. tunnel/ngrok hostname
# VITE_DEV_ALLOWED_HOSTS=your-app.ngrok-free.dev

# UPI payment config
VITE_UPI_HANDLE=merchant@upi
VITE_UPI_PAYEE_NAME=RideEasy

# Optional: Sentry
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0
