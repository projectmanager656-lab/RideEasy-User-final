# Used automatically when you run: npm run build
#
# The driver app MUST reach the same backend as the passenger app, otherwise a ride
# created on one server is never dispatched on the other. The passenger build targets
# http://192.168.1.15:5001, so the driver build must too. The previous value
# (https://cab-backend-o3sg.onrender.com) was a stale deployment running older socket
# code, so rideRequest never arrived. On a real release, restore the deployed HTTPS URL
# (and make sure passenger + driver both point at that same deployment).
VITE_BASE_URL=http://192.168.1.15:5001
VITE_SOCKET_URL=http://192.168.1.15:5001

VITE_UPI_HANDLE=merchant@upi
VITE_UPI_PAYEE_NAME=RideEasy
